{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kettle-foundation",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "workflows": [
    {
      "name": "kettle-foundation-check",
      "binding": "FOUNDATION_WORKFLOW",
      "class_name": "FoundationWorkflow"
    },
    {
      "name": "kettle-creator-pipeline",
      "binding": "CREATOR_WORKFLOW",
      "class_name": "CreatorPipelineWorkflow"
    }
  ],
  "env": {
    "development": {
      "name": "kettle-stage2-development",
      "workers_dev": true,
      "workflows": [
        {
          "name": "kettle-stage2-development-check",
          "binding": "FOUNDATION_WORKFLOW",
          "class_name": "FoundationWorkflow"
        },
        {
          "name": "kettle-stage2-development-creator",
          "binding": "CREATOR_WORKFLOW",
          "class_name": "CreatorPipelineWorkflow"
        }
      ],
      "secrets": {
        "required": [
          "AUTH_ISSUER",
          "AUTH_AUDIENCE",
          "AUTH_CLIENT_ID",
          "AUTH_CLIENT_SECRET",
          "AUTH_SESSION_SECRET",
          "SUPABASE_URL",
          "SUPABASE_SERVICE_ROLE_KEY",
          "LIGHTREEL_API_KEY",
          "SCRAPECREATORS_API_KEY"
        ]
      },
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1
        }
      },
      "vars": {
        "CREATOR_PIPELINE_ENABLED": "true",
        "CREATOR_MODEL": "gpt-4.1-mini",
        "CREATOR_SOURCE_PERMISSION_BASIS": "User-authorized bounded trial: Lightreel reviews the supplied public TikTok video; ScrapeCreators supplies public metadata and references. Riff does not download media. Provider-reported media access is not independently verified.",
        "CREATOR_SCRAPE_CEILING_MICROUSD": "0",
        "CREATOR_LIGHTREEL_CEILING_MICROUSD": "0",
        "CREATOR_OPENAI_CEILING_MICROUSD": "0"
      },
      "triggers": {
        "crons": [
          "*/2 * * * *"
        ]
      }
    }
  }
}
