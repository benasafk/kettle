{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kettle-foundation",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "workflows": [
    {
      "name": "kettle-foundation-check",
      "binding": "FOUNDATION_WORKFLOW",
      "class_name": "FoundationWorkflow"
    }
  ],
  "env": {
    "development": {
      "name": "kettle-stage2-development",
      "workers_dev": true,
      "workflows": [
        {
          "name": "kettle-stage2-development-check",
          "binding": "FOUNDATION_WORKFLOW",
          "class_name": "FoundationWorkflow"
        }
      ],
      "secrets": {
        "required": [
          "AUTH_ISSUER",
          "AUTH_AUDIENCE",
          "AUTH_CLIENT_ID",
          "AUTH_CLIENT_SECRET",
          "AUTH_SESSION_SECRET",
          "SUPABASE_URL",
          "SUPABASE_SERVICE_ROLE_KEY"
        ]
      },
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1
        }
      }
    }
  }
}
