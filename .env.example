# Stage 1 needs no credentials. Do not copy development database URLs between workspaces.
# Scripts read exported process variables; this file is not loaded automatically.
# Optional: export KETTLE_PORT=8787 (Conductor's allocated port takes precedence).
# Stage 2 server-only configuration, intentionally unwired in Stage 1:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# REFERENCE_PROVIDER_API_KEY=
