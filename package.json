{
  "name": "kettle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "setup": "npm ci && node scripts/workspace.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "db:reset": "node scripts/database.mjs reset",
    "db:status": "node scripts/database.mjs status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.0.0",
    "supabase": "2.119.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.147.0"
  }
}
